  <data name="sqlSelectCommand1.CommandText" xml:space="preserve">
    <value>SELECT ItemId, Title, Decription, Code, PurchasePrice, SalePrice, VendorId, OStock, Server_Id, Old_Id, TryToChange
FROM     Items
WHERE  (ItemId IN
                      (SELECT ItemId
                       FROM      ItemStock
                       WHERE   (ItemId IN
                                             (SELECT ItemId
                                              FROM      Items AS Items_1
                                              WHERE   (Old_Id IS NULL)))
                       GROUP BY ItemId))</value>
