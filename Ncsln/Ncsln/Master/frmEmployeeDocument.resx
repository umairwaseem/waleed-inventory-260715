  <data name="sqlUpdateCommand.CommandText" xml:space="preserve">
    <value>UPDATE [tbl_StudentDocuments] SET [DocumentId] = @DocumentId, [StudentId] = @StudentId, [DocumentName] = @DocumentName, [DocumentImage] = @DocumentImage, [DocumentType] = @DocumentType WHERE (([DocumentId] = @Original_DocumentId) AND ((@IsNull_StudentId = 1 AND [StudentId] IS NULL) OR ([StudentId] = @Original_StudentId)) AND ((@IsNull_DocumentName = 1 AND [DocumentName] IS NULL) OR ([DocumentName] = @Original_DocumentName)) AND ((@IsNull_DocumentType = 1 AND [DocumentType] IS NULL) OR ([DocumentType] = @Original_DocumentType)));
SELECT DocumentId, StudentId, DocumentName, DocumentImage, DocumentType FROM tbl_StudentDocuments WHERE (DocumentId = @DocumentId) ORDER BY DocumentName</value>
